+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Настройки HikeGram: режим призрака и сохранение удалённых сообщений. */
+public class HikeSettings {
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("hikegram", Context.MODE_PRIVATE);
+    }
+
+    /** Не отправлять статус «в сети» и «печатает». */
+    public static boolean ghostMode() {
+        return prefs().getBoolean("ghostMode", true);
+    }
+
+    public static void setGhostMode(boolean value) {
+        prefs().edit().putBoolean("ghostMode", value).apply();
+    }
+
+    /** Не удалять у себя сообщения, которые собеседник удалил. */
+    public static boolean keepDeleted() {
+        return prefs().getBoolean("keepDeleted", true);
+    }
+
+    public static void setKeepDeleted(boolean value) {
+        prefs().edit().putBoolean("keepDeleted", value).apply();
+    }
+}
