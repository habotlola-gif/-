# --- Telegram-бот (кнопки и ответы) ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Ваш числовой Telegram ID (узнать: @userinfobot). Бот отвечает только вам.
OWNER_ID=123456789

# --- Ваш аккаунт Telegram (чтение каналов) ---
# Получить на https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Модель и глубина анализа (low | medium | high)
DIGEST_MODEL=claude-opus-5-5
DIGEST_EFFORT=medium

# --- Настройки дайджеста ---
# Сколько новостей показывать
TOP_N=7
# Первый запуск и кнопка «За 24 часа» смотрят столько часов назад
DEFAULT_HOURS=24
# Кнопка «Найти интересное» берёт посты с прошлого нажатия, но не старше этого
MAX_LOOKBACK_HOURS=72
# Не больше стольких постов с одного канала
MAX_POSTS_PER_CHANNEL=40
# Если список каналов пуст, читаются все подписки, но не больше этого числа
MAX_CHANNELS=60

# Где хранить сессию и настройки
DATA_DIR=data
