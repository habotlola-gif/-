# --- Telegram-бот (кнопки и ответы) ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Ваш числовой Telegram ID (узнать: @userinfobot). Бот отвечает только вам.
OWNER_ID=123456789

# --- Ваш аккаунт Telegram (чтение каналов) ---
# Получить на https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# --- Языковая модель (бесплатно) ---
# По умолчанию OpenRouter: ключ без карты на https://openrouter.ai/keys
# Бесплатно 50 запросов в день; openrouter/free сам выбирает свободную бесплатную модель.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=openrouter/free

# Вариант: Google Gemini (ключ на https://aistudio.google.com/apikey, в России официально не работает)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-…-flash   # точное имя бесплатной flash-модели посмотрите в AI Studio
# MAX_INPUT_CHARS=300000

# Вариант: своя модель на компьютере через Ollama (бесплатно и без лимитов)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3:8b
# MAX_INPUT_CHARS=30000

# --- Настройки дайджеста ---
# Сколько новостей показывать
TOP_N=7
# Первый запуск и кнопка «За 24 часа» смотрят столько часов назад
DEFAULT_HOURS=24
# Кнопка «Найти интересное» берёт посты с прошлого нажатия, но не старше этого
MAX_LOOKBACK_HOURS=72
# Не больше стольких постов с одного канала
MAX_POSTS_PER_CHANNEL=40
# Если список каналов пуст, читаются все подписки, но не больше этого числа
MAX_CHANNELS=60
# Сколько текста отправлять модели за раз (бесплатные модели ограничены по длине).
# Если постов больше — берутся самые популярные в своих каналах.
MAX_INPUT_CHARS=60000
# Длинные посты обрезаются до стольких символов
MAX_POST_CHARS=1000

# Где хранить сессию и настройки
DATA_DIR=data
